<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SegundaTela" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_dark</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>

    <style name="Theme.SegundaTela.Fullscreen" parent="Theme.SegundaTela">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- Cartão de seção (cantos bem arredondados, estilo One UI) -->
    <style name="Card.Section" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">26dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- Botão principal em pílula -->
    <style name="Btn.Primary" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_height">58dp</item>
        <item name="cornerRadius">29dp</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <!-- Cabeçalho de grupo (fora do cartão), como nos Ajustes do One UI -->
    <style name="Label.Section" parent="">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <!-- Botão da barra de atalhos do visualizador -->
    <style name="KeyBtn" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:textColor">#EDF1F7</item>
        <item name="android:textSize">13sp</item>
        <item name="strokeColor">@color/stroke</item>
        <item name="android:textAllCaps">false</item>
    </style>
</resources>
